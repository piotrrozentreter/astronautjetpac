const KEY_ESC = 69;
const JOY_RIGHT = 2;
const JOY_DOWN = 4;
const JOY_LEFT = 512;
const JOY_UP = 1024;
const PLAYER_SPEED = 2;
const PLAYER_MAX_X = 288;
const PLAYER_MAX_Y = 224;
const PLAYER_BOB_W_M1 = 16;  // sprite right-edge offset (17 px wide -> last pixel at +16)
const PLAYER_BOB_H_M1 = 30;  // sprite bottom-edge offset (31 px tall -> last pixel at +30)

const MAP_WIDTH = 20;
const MAP_HEIGHT = 10;
const TILE_WIDTH = 16;
const TILE_HEIGHT = 16;

const MAX_COLORS = 32;
const TOTAL_BOB_ASSETS = 54;
const WALK_ANIM_FRAMES = 6;
const WALK_ANIM_RATE = 4;
const FLY_ANIM_FRAMES = 5;
const FLY_ANIM_RATE = 4;
const GRAVITY = 1;
const THRUST = 3;
const MAX_VEL_DOWN = 6;
const LASER_SPEED = 8;
const LASER_RANGE_STEPS = 40;  // 40 steps x 8 px = 320 px — stops at screen edge
const LASER_MAX_X = 304;       // right boundary (beam is 16 px wide so max byte-start)
const LASER_Y_OFFSET = 12;
const MAX_BEAMS = 4;

const MAX_LEVELS = 1;

