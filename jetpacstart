; $VER: jetpacstart 1.0 (29.07.2026)
; Runs frontpage first, then launches the main game.

FAILAT 21
CD PROGDIR:

IF EXISTS "frontpage.exe"
  ECHO "Running frontpage.exe ..."
  frontpage.exe
ELSE
  ECHO "frontpage.exe not found in this drawer."
ENDIF

IF EXISTS "jetpac.exe"
  ECHO "Starting jetpac.exe ..."
  jetpac.exe
ELSE
  ECHO "jetpac.exe not found in this drawer."
ENDIF